# Copy this file to .env and fill in a real secret key before starting Penpot.
#
# Generate a secret key with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# Pin the Penpot version. Check https://github.com/penpot/penpot/releases for
# the latest tag before upgrading. Update in small increments (see PENPOT_SETUP.md).
PENPOT_VERSION=2.16

# Master key Penpot derives session/invitation keys from. MUST be set to a
# real random value — do not use the placeholder below.
PENPOT_SECRET_KEY=change-this-insecure-key
